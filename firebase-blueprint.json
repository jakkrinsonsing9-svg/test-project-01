{
  "entities": {
    "User": {
      "title": "User",
      "description": "DormTalk user profile with room info and verification status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "studentIdMasked": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "emailMasked": { "type": "string", "maxLength": 100 },
        "realBuilding": { "type": "string", "maxLength": 100 },
        "realRoom": { "type": "string", "maxLength": 30 },
        "anonymousTag": { "type": "string", "maxLength": 20 },
        "floor": { "type": "string", "maxLength": 30 },
        "isVerified": { "type": "boolean" },
        "defaultAnonymous": { "type": "boolean" },
        "darkMode": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "anonymousTag"]
    },
    "Post": {
      "title": "Post",
      "description": "Community posts from dorm residents",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 100 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorBuilding": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryKey": { "type": "string", "maxLength": 50 },
        "categoryEmoji": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "imageCaption": { "type": "string", "maxLength": 200 },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "commentsCount": { "type": "number" },
        "isUrgent": { "type": "boolean" },
        "statusUpdate": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["author", "category", "content"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comments attached to posts",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 100 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorRole": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 2000 },
        "likes": { "type": "number" },
        "avatarColor": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["author", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user preferences and masked identity"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Dorm community posts and announcements"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Threaded comments for a given post"
    }
  }
}
